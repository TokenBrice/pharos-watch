#!/usr/bin/env bash
set -euo pipefail

zero_sha_re='^0+$'
head_sha="$(git rev-parse --verify 'HEAD^{commit}')"
verified_head=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [[ -z "${local_sha:-}" || "$local_sha" =~ $zero_sha_re ]]; then
    continue
  fi

  if [[ "$local_sha" != "$head_sha" ]]; then
    echo "[pre-push] ${remote_ref} does not point at checked-out HEAD; GitHub Actions will validate it." >&2
    continue
  fi

  if [[ "$verified_head" -eq 0 ]]; then
    echo "[pre-push] Verifying commit-derived artifacts for ${head_sha}..."
    npm run check:commit-derived-artifacts
    verified_head=1
  fi
done
