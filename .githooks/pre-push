#!/usr/bin/env bash
set -euo pipefail

zero_sha_re='^0+$'
main_update_seen=0
pages_smoke_flag="${MERGE_GATE_PAGES_SMOKE:-1}"
branch_gate_mode="${PHAROS_PRE_PUSH_GATE:-main}"
branch_updates=()

run_gate() {
  if [[ "${PHAROS_PRE_PUSH_SKIP_RECEIPT:-0}" != "1" ]] &&
    node scripts/maintenance/check-merge-gate-receipt.mjs; then
    echo "[pre-push] Reusing the matching clean-state merge-gate receipt."
    return 0
  fi

  npm run test:merge-gate
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_ref:-}" ]]; then
    continue
  fi

  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    branch_updates+=("$local_ref" "$local_sha" "$remote_ref" "$remote_sha")
    continue
  fi

  main_update_seen=1

  if [[ "$local_sha" =~ $zero_sha_re ]]; then
    echo "[pre-push] Skipping merge gate for main deletion."
    continue
  fi

  echo "[pre-push] Running merge gate for main push range ${remote_sha}...${local_sha}..."
  if [[ "$remote_sha" =~ $zero_sha_re ]]; then
    MERGE_GATE_PAGES_SMOKE="$pages_smoke_flag" MERGE_GATE_FULL_DEPLOY=1 MERGE_GATE_HEAD_REF="$local_sha" run_gate
  else
    MERGE_GATE_PAGES_SMOKE="$pages_smoke_flag" MERGE_GATE_FULL_DEPLOY=0 MERGE_GATE_BASE_REF="$remote_sha" MERGE_GATE_HEAD_REF="$local_sha" run_gate
  fi
done

if [[ "$main_update_seen" -eq 0 ]]; then
  if [[ "$branch_gate_mode" != "all" && "$branch_gate_mode" != "1" ]]; then
    echo "[pre-push] No main ref update detected; full local gate skipped. Set PHAROS_PRE_PUSH_GATE=all to gate branch pushes."
    exit 0
  fi

  for ((index = 0; index < ${#branch_updates[@]}; index += 4)); do
    local_ref="${branch_updates[index]}"
    local_sha="${branch_updates[index + 1]}"
    remote_ref="${branch_updates[index + 2]}"
    remote_sha="${branch_updates[index + 3]}"

    if [[ "$local_sha" =~ $zero_sha_re ]]; then
      echo "[pre-push] Skipping merge gate for deletion of ${remote_ref}."
      continue
    fi

    echo "[pre-push] Opt-in branch gate for ${remote_ref}."
    if [[ "$remote_sha" =~ $zero_sha_re ]]; then
      MERGE_GATE_PAGES_SMOKE="$pages_smoke_flag" MERGE_GATE_FULL_DEPLOY=1 MERGE_GATE_HEAD_REF="$local_sha" run_gate
    else
      MERGE_GATE_PAGES_SMOKE="$pages_smoke_flag" MERGE_GATE_FULL_DEPLOY=0 MERGE_GATE_BASE_REF="$remote_sha" MERGE_GATE_HEAD_REF="$local_sha" run_gate
    fi
  done
fi
