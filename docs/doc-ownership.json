{
  "version": 2,
  "status": "canonical",
  "purpose": "Canonical source-to-document routing for agents and change checks. Code, schemas, registries, and checked runtime data remain authoritative for behavior.",
  "baseDocs": ["docs/process/agent-start-here.md"],
  "coreRules": [
    "Prefer the smallest root-cause fix; avoid unrelated refactors.",
    "Update matching docs for behavior, API, pipeline, methodology, or data-source changes.",
    "Do not replace DefiLlama list supply with manual/on-chain/CMC/DEX overrides; supplemental supply admission paths must be explicit, documented, fail-closed, and double-count safe.",
    "Keep Tailwind classes as static strings.",
    "Do not edit shadcn primitives in src/components/ui/ unless explicitly required."
  ],
  "mappings": [
    {
      "id": "stablecoin-registry",
      "label": "Stablecoin data and research sidecars",
      "risk": "high",
      "sources": [
        "shared/data/stablecoins/coins/**",
        "shared/data/stablecoins/canonical-order.json",
        "shared/data/stablecoins/listing-decisions.json",
        "shared/data/stablecoins/domains/**",
        "shared/data/stablecoins/compliance/**",
        "shared/data/stablecoins/reserves/**",
        "shared/lib/stablecoins/**",
        "shared/lib/stablecoin-id-registry.ts",
        "shared/lib/classification.ts",
        "shared/lib/shadow-stablecoins.ts"
      ],
      "docs": [
        "docs/stablecoin-data.md",
        "docs/classification.md",
        { "path": "docs/process/adding-a-stablecoin.md", "anchor": "source-of-truth" },
        "docs/process/stablecoin-research-sidecars.md"
      ],
      "background": ["docs/listing-policy.md", "docs/about-page.md", "docs/shadow-stablecoins.md"],
      "alsoRead": ["shared/data/stablecoins/AGENTS.md"],
      "checks": [
        "npm run lint:changed",
        "npm run check:stablecoin-data",
        "npm run check:generated-artifacts -- --only=stablecoin-client-projections",
        "npm run typecheck",
        "npm run typecheck:worker",
        "npx vitest run shared/lib/stablecoins shared/lib/__tests__/stablecoin-id-registry.test.ts"
      ],
      "rules": [
        "Keep canonical order, generated data, and schemas aligned.",
        "Commit base coin sources before final sitemap-date generation.",
        "Do not add ad hoc supply overrides outside documented fail-closed admission paths."
      ],
      "hints": ["Update methodology docs only when scoring or classification semantics change."]
    },
    {
      "id": "pricing-pipeline",
      "label": "Pricing and supply pipelines",
      "risk": "high",
      "sources": [
        "worker/src/cron/sync-stablecoins/**",
        "worker/src/cron/snapshot-supply.ts",
        "worker/src/cron/snapshot-chain-supply.ts",
        "worker/src/cron/sync-v9-supply-attribution.ts",
        "worker/src/lib/price*.ts",
        "worker/src/lib/address-price-providers/**",
        "worker/src/lib/authoritative-price-sources/**",
        "shared/lib/pricing-*.ts",
        "shared/lib/pricing-provider-config.ts",
        "shared/lib/supply.ts",
        "shared/lib/onchain-supply-probe.ts"
      ],
      "docs": [
        { "path": "docs/pricing-pipeline.md", "anchor": "primary-consensus" },
        { "path": "docs/supply-snapshot.md", "anchor": "supply-pipeline" }
      ],
      "background": ["docs/about-page.md", "docs/data-flow-map.md"],
      "checks": ["npm run lint:changed", "npm run typecheck", "npm run typecheck:worker", "npm run audit:pricing-providers", "npx vitest run worker/src/lib"],
      "rules": [
        "Consume or cancel failed fetch bodies before opening more Worker fetches.",
        "Do not multiply DefiLlama list-endpoint supply by price."
      ],
      "hints": ["Structured methodology history lives under shared/data/methodology-changelogs/pricing-pipeline/."]
    },
    {
      "id": "worker-api-auth",
      "label": "Worker API and authentication",
      "risk": "high",
      "sources": [
        "shared/lib/api-endpoints/**",
        "worker/src/routes/**",
        "worker/src/router.ts",
        "worker/src/api/**",
        "worker/src/handlers/http/**",
        "worker/src/lib/auth.ts",
        "worker/src/lib/idempotency.ts",
        "functions/admin/**",
        "functions/admin-api/**",
        "functions/_middleware.ts",
        "functions/_site-data/**",
        "shared/lib/runtime-origins.ts",
        "shared/lib/site-csp.ts",
        "public/_headers",
        "public/_routes.json"
      ],
      "docs": [
        "docs/api-endpoint-authoring.md",
        { "path": "docs/worker-infrastructure.md", "anchor": "http-request-handling" },
        "docs/security-governance.md",
        { "path": "docs/operator-origin-access.md", "anchor": "repo-side-changes" },
        { "path": "docs/api-reference.md", "anchor": "public-endpoints" },
        "docs/api-reference-admin.md"
      ],
      "background": ["docs/data-flow-map.md"],
      "checks": ["npm run lint:changed", "npm run typecheck", "npm run typecheck:worker", "npm run test:critical-contracts", "npm run check:site-csp-sync", "npm run check:frozen-invariants"],
      "rules": ["Route flags, auth lane behavior, cache metadata, and site-data allowlists are centralized."]
    },
    {
      "id": "worker-cron",
      "label": "Worker cron and scheduled pipelines",
      "risk": "high",
      "sources": [
        "shared/lib/cron-jobs.ts",
        "shared/lib/scheduled-runner-registry.ts",
        "worker/wrangler.toml",
        "worker/src/handlers/scheduled/**",
        "worker/src/cron/**"
      ],
      "docs": ["docs/process/cron-trigger-policy.md"],
      "background": [
        "docs/worker-and-api-limits.md",
        "docs/data-flow-map.md",
        { "path": "docs/worker-infrastructure.md", "anchor": "cron-scheduling" }
      ],
      "alsoRead": ["worker/AGENTS.md"],
      "checks": ["npm run lint:changed", "npm run typecheck:worker", "npm run check:cron-sync", "npm run check:cron-connections", "npx vitest run worker/src/cron worker/src/handlers/scheduled"],
      "rules": [
        "Pick the trigger slot before adding fetch-heavy work.",
        "Cron jobs use Pharos's conservative six-connection trigger budget; consume response bodies before opening more fetches."
      ]
    },
    {
      "id": "telegram",
      "label": "Telegram ingress, commands, dispatch, and Mini App",
      "risk": "high",
      "sources": [
        "worker/src/api/telegram*.ts",
        "worker/src/api/telegram-*/**",
        "worker/src/api/webhook-commands/**",
        "worker/src/cron/*telegram*.ts",
        "worker/src/cron/dispatch-telegram*.ts",
        "worker/src/cron/telegram-*/**",
        "worker/src/handlers/scheduled/*telegram*.ts",
        "worker/src/lib/telegram-*.ts",
        "shared/lib/telegram-*.ts",
        "shared/lib/telegram-delivery-policy.ts",
        "src/app/pharoswatchbot/**"
      ],
      "docs": [
        { "path": "docs/telegram-architecture.md", "anchor": "1-ingress" },
        { "path": "docs/telegram-alerts.md", "anchor": "commands" },
        { "path": "docs/telegram-alerts.md", "anchor": "dispatch" },
        "docs/telegram-mini-app.md"
      ],
      "background": ["docs/runbooks/telegram-no-delivery.md", "docs/runbooks/telegram-rate-limit-storm.md"],
      "checks": ["npm run lint:changed", "npm run typecheck", "npm run typecheck:worker", "npm run check:telegram-load", "npm run check:cron-sync", "npx vitest run worker/src/api worker/src/cron"],
      "rules": [
        "Preserve webhook authentication, signed initData validation, and idempotent update handling.",
        "Preserve the durable delivery evidence trail."
      ]
    },
    {
      "id": "d1-migration",
      "label": "D1 schema or migration",
      "risk": "high",
      "sources": [
        "worker/migrations/**",
        "worker/src/lib/db*.ts",
        "worker/src/lib/*store*.ts",
        "worker/src/api/backfill-*.ts"
      ],
      "docs": [
        "docs/deployment-process.md",
        { "path": "docs/worker-infrastructure.md", "anchor": "shared-database-helpers" }
      ],
      "background": ["worker/migrations/MANIFEST.md", "docs/process/d1-baseline-squash-plan.md"],
      "checks": ["npm run lint:changed", "npm run typecheck:worker", "npm run check:migrations", "npx vitest run worker/src"],
      "rules": [
        "Migrations must be backward-compatible because CI applies D1 migrations before the new Worker is live.",
        "Destructive cleanup requires a separate coordinated rollout."
      ]
    },
    {
      "id": "methodology-scoring",
      "label": "Methodology and scoring",
      "risk": "high",
      "sources": [
        "shared/data/methodology-changelogs/**",
        "shared/lib/methodology-versions/**",
        "shared/lib/report-card*.ts",
        "shared/lib/peg-score.ts",
        "shared/lib/dews-config.ts",
        "shared/lib/liquidity-score-weights.ts",
        "shared/lib/depeg-resolver/**",
        "worker/src/lib/stability-index.ts",
        "worker/src/lib/mint-burn-scoring.ts",
        "worker/src/lib/dews.ts",
        "worker/src/cron/compute-depeg-resolver.ts",
        "worker/src/api/depeg-resolver.ts",
        "src/app/methodology/**",
        "docs/process/ddrr-calibration.md",
        "docs/process/mechanism-overlay-evidence-standard.md"
      ],
      "docs": ["docs/methodology-page.md", "docs/report-cards.md"],
      "background": [
        { "path": "docs/depeg-detection.md", "anchor": "thresholds--constants" },
        "docs/dews.md",
        "docs/depeg-resolver.md",
        { "path": "docs/dex-liquidity.md", "anchor": "dex-liquidity-score" },
        "docs/mint-authority-scoring.md",
        "docs/stability-index.md",
        { "path": "docs/mint-burn-flows.md", "anchor": "scoring" },
        "docs/process/ddrr-calibration.md",
        "docs/process/mechanism-overlay-evidence-standard.md"
      ],
      "checks": ["npm run check:doc-sync", "npx vitest run shared/lib worker/src/lib"],
      "rules": ["Methodology versions increase numerically: after v5.9 use v5.91 or v6.0, not v5.10."],
      "hints": ["Structured methodology changelogs live under shared/data/methodology-changelogs/; update the matching entry for semantic changes."]
    },
    {
      "id": "safety-score-v9",
      "label": "Safety Score V9 and publication surfaces",
      "risk": "high",
      "sources": [
        "shared/lib/safety-score-v9/**",
        "shared/types/safety-score-v9*.ts",
        "shared/types/digest*.ts",
        "shared/data/safety-score-v9/**",
        "worker/src/lib/safety-score-v9-*.ts",
        "worker/src/lib/digest-safety-map.ts",
        "worker/src/cron/daily-digest.ts",
        "worker/src/cron/daily-digest/**",
        "worker/src/cron/digest/**",
        "worker/src/cron/digest-publication-watchdog.ts",
        "worker/src/handlers/scheduled/digest-trigger-poll.ts",
        "worker/src/cron/prepare-safety-score-v9-input.ts",
        "worker/src/cron/compute-safety-score-v9.ts",
        "worker/src/cron/snapshot-safety-grade-history.ts",
        "src/lib/mint-authority-display.ts",
        "src/components/stablecoin-detail/mint-authority-section.tsx",
        "shared/data/stablecoins/domains/mint-authority/**",
        "src/app/safety-scores/map/**",
        "functions/safety-scores/**",
        "scripts/maintenance/build-safety-score-map.ts",
        "scripts/maintenance/publish-safety-score-map.ts",
        ".github/workflows/safety-map-refresh.yml",
        "functions/__tests__/safety-map-png.test.ts"
      ],
      "docs": [
        "docs/report-cards.md",
        "docs/mint-authority-scoring.md",
        "docs/safety-score-map.md",
        { "path": "docs/digest-pipeline.md", "anchor": "generation" },
        { "path": "docs/digest-pipeline.md", "anchor": "distribution" }
      ],
      "background": [
        "docs/tape-page.md",
        "docs/process/safety-score-equivalence-harness.md",
        "docs/process/safety-score-curation-expiry-sweep.md"
      ],
      "checks": ["npm run check:doc-sync", "npm run audit:mint-authority-review", "npx vitest run shared/lib/safety-score-v9 worker/src/lib"],
      "rules": [
        "Current consumers fail closed when the accepted V9 publication is unavailable or held.",
        "Safety Score V9 Economic Control owns the sole published mint score."
      ]
    },
    {
      "id": "worker-env-contract",
      "label": "Worker environment contract",
      "risk": "high",
      "sources": [
        "shared/lib/env-contract.ts",
        "shared/lib/env-contract/**",
        "worker/src/lib/env.ts",
        "worker/wrangler.toml",
        "scripts/ci/check-env-contract.ts"
      ],
      "docs": [
        { "path": "docs/worker-infrastructure.md", "anchor": "env-interface" },
        { "path": "docs/operator-origin-access.md", "anchor": "runtime-origin-bindings" },
        "docs/deployment-process.md",
        "docs/scripts.md",
        "README.md"
      ],
      "checks": ["npm run check:env-contract"],
      "rules": ["Environment documentation names variables only; never print or copy secret values."]
    },
    {
      "id": "status-and-runbooks",
      "label": "Status model and operational runbooks",
      "risk": "high",
      "sources": [
        "worker/src/lib/status/**",
        "worker/src/lib/status-evaluation.ts",
        "worker/src/lib/public-health-assessment.ts",
        "src/lib/status/**",
        "src/lib/status-dashboard-model.ts",
        "docs/runbooks/**"
      ],
      "docs": [
        { "path": "docs/status-dashboard.md", "anchor": "backend-contract-get-apistatus" },
        { "path": "docs/worker-infrastructure.md", "anchor": "health--status-endpoints" }
      ],
      "checks": ["npx vitest run src/lib/status worker/src/lib/status"],
      "rules": ["Status causes, recommended actions, public-health floors, and runbooks must remain aligned."]
    },
    {
      "id": "validation-ci-policy",
      "label": "Deployment, CI, and repository policy",
      "risk": "high",
      "sources": [
        "scripts/**",
        ".github/**",
        ".githooks/**",
        "package.json",
        "package-lock.json",
        "worker/package.json",
        ".gitignore",
        "functions/**",
        "next.config.ts",
        "eslint.config.mjs",
        "eslint.typed.config.mjs",
        "playwright.config.ts",
        "playwright.ops.config.ts",
        "postcss.config.mjs",
        "tsconfig*.json",
        "vitest.config.ts"
      ],
      "docs": [
        { "path": "docs/testing.md", "anchor": "commands" },
        "docs/deployment-process.md",
        "docs/scripts.md",
        "docs/process/feature-flags.md"
      ],
      "background": ["docs/architecture.md"],
      "checks": ["npx vitest run scripts/__tests__", "npm run check:generated-artifacts"],
      "rules": [
        "Keep deploy-surface classification aligned with GitHub deploy behavior.",
        "Commit relevant sources before generating git-history-derived artifacts."
      ]
    },
    {
      "id": "agent-hooks-process",
      "label": "Agent guidance and local hook process",
      "risk": "high",
      "sources": [
        ".agents/**",
        ".claude/**",
        ".codex/**",
        "AGENTS.md",
        "CLAUDE.md",
        "docs/process/agent-start-here.md",
        "docs/process/agent-artifacts.md",
        "scripts/ci/pharos-change-contract.ts",
        "scripts/lib/doc-ownership-registry.mts",
        "scripts/maintenance/generate-agents-doc.ts",
        "scripts/maintenance/setup-agent-hooks.ts"
      ],
      "docs": ["docs/process/agent-start-here.md", "docs/process/agent-artifacts.md", "CLAUDE.md"],
      "checks": ["npm run check:generated-artifacts -- --only=agents-doc", "npx vitest run scripts/__tests__/pharos-change-contract.test.ts scripts/__tests__/doc-ownership-registry.test.ts"],
      "rules": [
        "Top-level AGENTS.md and CLAUDE.md are deliberately kept in sync.",
        "Temporary agent output belongs in ignored scratch locations, not committed docs."
      ]
    },
    {
      "id": "frontend-routes",
      "label": "Frontend page or route behavior",
      "risk": "medium",
      "sources": ["src/**", "shared/lib/public-docs.ts", "next.config.ts"],
      "docs": ["docs/architecture.md"],
      "background": [{ "path": "docs/design-language.md", "anchor": "context" }],
      "alsoRead": ["src/AGENTS.md"],
      "rules": ["Static export means route metadata, sitemap, and crawlability can matter even for simple UI changes."],
      "checks": ["npm run lint:changed", "npm run typecheck", "npx vitest run src"]
    },
    {
      "id": "worker-runtime",
      "label": "Worker runtime implementation",
      "risk": "medium",
      "sources": ["worker/src/**", "worker/scripts/**", "worker/*.ts", "worker/AGENTS.md", "worker/tsconfig.json", "worker/wrangler.toml"],
      "docs": [{ "path": "docs/worker-infrastructure.md", "anchor": "module-initialization" }],
      "background": ["docs/worker-and-api-limits.md"],
      "alsoRead": ["worker/AGENTS.md"],
      "rules": ["Consume Worker response bodies before opening more fetches."]
    },
    {
      "id": "shared-runtime",
      "label": "Shared runtime contracts",
      "risk": "medium",
      "sources": ["shared/**"],
      "docs": ["docs/architecture.md"],
      "background": ["docs/data-flow-map.md"],
      "alsoRead": ["shared/AGENTS.md"],
      "rules": ["Use @shared/lib/... and @shared/types... for shared runtime imports; avoid relative cross-boundary imports."]
    },
    {
      "id": "documentation",
      "label": "Verified documentation",
      "risk": "low",
      "tier": "fallback",
      "sources": ["docs/**", "README.md", "CONTRIBUTING.md"],
      "docs": ["docs/README.md", "docs/doc-ownership.json"],
      "rules": ["Treat docs/ and README.md as the verified documentation corpus."]
    }
  ],
  "exclusions": [
    { "sources": ["shared/data/stablecoins/coins/.gitkeep"], "reason": "Directory sentinel only; read the stablecoin registry contract for real entries." },
    { "sources": ["shared/test-utils/**", "shared/types/__tests__/**", "src/__tests__/**", "src/test/**", "src/test-utils/**", "worker/src/__mocks__/**", "worker/src/__tests__/**", "worker/scripts/__tests__/**", "worker/scripts/data/**"], "reason": "Implementation-only tests and fixtures; read the matched parent contract." },
    { "sources": ["src/assets/**", "worker/assets/**"], "reason": "Implementation-only generated or licensed assets; read the matched design or font contract." }
  ]
}
