# Worker env reference for `worker/src/lib/env.ts`.
# Secrets typically use `wrangler secret put`; plain vars usually live in `worker/wrangler.toml [vars]`
# or are configured directly in Cloudflare.
#
# DB is configured separately in `worker/wrangler.toml` under `[d1_databases]`.
# Pages Functions bindings used by the ops admin proxy (`OPS_API_SERVICE_TOKEN_ID`,
# `OPS_API_SERVICE_TOKEN_SECRET`) are not part of this worker env surface; see
# `docs/operator-origin-access.md`.

# Required in production for feedback / abuse controls
FEEDBACK_IP_SALT=
GITHUB_PAT=

# Optional salts / access config
PUBLIC_API_RATE_LIMIT_SALT=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_OPS_UI_AUD=
CF_ACCESS_OPS_API_AUD=

# Optional upstream integration secrets
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
DRPC_API_KEY=
ALCHEMY_API_KEY=
ALERT_WEBHOOK_URL=
ANTHROPIC_API_KEY=
GRAPH_API_KEY=
CMC_API_KEY=
COINGECKO_API_KEY=
GITHUB_REPO_NODE_ID=
GITHUB_DISCUSSION_CATEGORY_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional runtime overrides / operator origins
OPS_UI_ORIGIN=https://ops.pharos.watch
OPS_API_ORIGIN=https://ops-api.pharos.watch
MINT_BURN_DISABLED_IDS=
MINT_BURN_DISABLED_SYMBOLS=
MINT_BURN_MAJOR_SYMBOLS=
MINT_BURN_STALE_WARN_SEC=
MINT_BURN_STALE_CRIT_SEC=
MINT_BURN_ALERT_COOLDOWN_SEC=
MAINTENANCE_MODE=

# Worker vars
CORS_ORIGIN=https://pharos.watch,https://ops.pharos.watch
SELF_URL=https://api.pharos.watch
