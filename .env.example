# Required secrets and optional secrets for `worker/src/lib/env.ts` bindings
# Configure secrets with `wrangler secret put`.

# Required for feedback and admin workflows in production
ADMIN_KEY=
FEEDBACK_IP_SALT=
GITHUB_PAT=

# Optional integration secrets (safe defaults when omitted)
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
DRPC_API_KEY=
ALCHEMY_API_KEY=
ALERT_WEBHOOK_URL=
ANTHROPIC_API_KEY=
GRAPH_API_KEY=
CMC_API_KEY=
COINGECKO_API_KEY=
GITHUB_REPO_NODE_ID=
GITHUB_DISCUSSION_CATEGORY_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
MINT_BURN_DISABLED_IDS=
MINT_BURN_DISABLED_SYMBOLS=
MINT_BURN_MAJOR_SYMBOLS=
MINT_BURN_STALE_WARN_SEC=
MINT_BURN_STALE_CRIT_SEC=
MINT_BURN_ALERT_COOLDOWN_SEC=
MAINTENANCE_MODE=

# Worker vars (set in wrangler.toml [vars])
# DB is configured separately in wrangler.toml [d1_databases] with binding name DB and is not set here.
CORS_ORIGIN=https://pharos.watch
SELF_URL=https://api.pharos.watch
