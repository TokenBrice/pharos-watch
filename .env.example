# Canonical runtime binding groups live in:
# - `worker/src/lib/env.ts`
# - `functions/lib/ops-env.ts`
#
# Secrets typically use `wrangler secret put`; plain worker vars usually live in
# `worker/wrangler.toml [vars]` or are configured directly in Cloudflare.
# `DB` is configured separately in `worker/wrangler.toml` under `[d1_databases]`.

# Frontend optional build/runtime bindings
# `NEXT_PUBLIC_API_BASE` is mainly for local `next dev` or non-Pharos hosts.
# When unset, the client auto-resolves `https://api.pharos.watch` on
# `*.pharos.watch` and `*.stablecoin-dashboard.pages.dev`.
NEXT_PUBLIC_API_BASE=
# Optional GA4 measurement ID. When unset, no analytics script or custom-event
# telemetry is injected by `src/app/layout.tsx`.
NEXT_PUBLIC_GA_ID=

# Worker required active bindings
CORS_ORIGIN=https://pharos.watch,https://ops.pharos.watch

# Worker optional active bindings
SELF_URL=https://api.pharos.watch
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_OPS_API_AUD=
FEEDBACK_IP_SALT=
# Required for deployed public API traffic. Public `/api/*` requests return 503
# until this binding is configured.
PUBLIC_API_RATE_LIMIT_SALT=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
DRPC_API_KEY=
ALCHEMY_API_KEY=
ALERT_WEBHOOK_URL=
ANTHROPIC_API_KEY=
GRAPH_API_KEY=
CMC_API_KEY=
COINGECKO_API_KEY=
OPENEXCHANGERATES_API_KEY=
SIM_API_KEY=
GITHUB_PAT=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
MINT_BURN_DISABLED_IDS=
MINT_BURN_DISABLED_SYMBOLS=
MINT_BURN_MAJOR_SYMBOLS=
MINT_BURN_STALE_WARN_SEC=
MINT_BURN_STALE_CRIT_SEC=
MINT_BURN_ALERT_COOLDOWN_SEC=
MAINTENANCE_MODE=

# Worker reserved-only keys.
# The worker keeps these names reserved for cross-runtime alignment, but it does
# not currently consume them at runtime.
OPS_UI_ORIGIN=https://ops.pharos.watch
OPS_API_ORIGIN=https://ops-api.pharos.watch
CF_ACCESS_OPS_UI_AUD=

# Pages Functions required active bindings for the ops admin proxy
OPS_API_SERVICE_TOKEN_ID=
OPS_API_SERVICE_TOKEN_SECRET=

# Pages Functions optional active bindings
# `OPS_UI_ORIGIN` and `OPS_API_ORIGIN` are the same names listed above as
# worker-reserved keys, but they are active on the Pages Functions runtime.

# Pages Functions reserved-only keys
# `CF_ACCESS_TEAM_DOMAIN` is active on the worker and reserved on Pages.
