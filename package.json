{
  "name": "stablecoin-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "worker"
  ],
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "dev": "node scripts/run-dev-api-proxy.mjs & next dev",
    "dev:next": "next dev",
    "dev:proxy": "node scripts/run-dev-api-proxy.mjs",
    "prebuild": "tsx scripts/generate-sitemap-dates.ts && tsx scripts/generate-docs-metadata.ts && tsx scripts/generate-cemetery-dataset.ts && tsx scripts/generate-postman-collection.ts && tsx scripts/generate-openapi-spec.ts && tsx scripts/generate-llms-txt.ts",
    "build": "next build",
    "build:world-map": "tsx scripts/build-world-map-svg.ts",
    "postbuild": "tsx scripts/generate-markdown-exports.ts",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/ --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:worker": "cd worker && npx tsc --noEmit",
    "typecheck:worker-scripts": "cd worker && npx tsc --noEmit -p tsconfig.scripts.json",
    "audit:deps": "npm audit --audit-level=high --omit=dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:critical-contracts": "vitest run src/lib/__tests__/api-fetch-contracts.test.ts src/lib/__tests__/api-endpoints.test.ts worker/src/api/__tests__/router-contract.test.ts worker/src/api/__tests__/cache-passthrough.test.ts worker/src/api/__tests__/peg-summary.test.ts worker/src/api/__tests__/report-cards.test.ts worker/src/api/__tests__/stability-index.test.ts worker/src/api/__tests__/dex-liquidity.test.ts worker/src/api/__tests__/stress-signals.test.ts worker/src/api/__tests__/mint-burn-flows.test.ts",
    "test:invariants": "vitest run src/lib/__tests__/critical-invariants.test.ts worker/src/lib/__tests__/api-utils.test.ts worker/src/cron/__tests__/sync-stablecoins.test.ts worker/src/cron/__tests__/sync-yield-data.test.ts",
    "test:noncritical": "node scripts/run-noncritical-tests.mjs",
    "coverage:critical": "node scripts/run-critical-coverage.mjs",
    "coverage:critical:update-baseline": "node scripts/update-critical-coverage-baseline.mjs",
    "test:merge-gate": "node scripts/test-merge-gate.mjs",
    "validate:lts": "node scripts/run-node-lts-validation.mjs",
    "validate:prebuild": "node scripts/run-validate-prebuild.mjs",
    "test:watch": "vitest",
    "audit:pricing-providers": "tsx scripts/audit-pricing-provider-config.ts",
    "freeze-stablecoin": "tsx scripts/freeze-stablecoin.ts",
    "sync:digests": "tsx scripts/sync-digests.ts",
    "serve:static-export": "npx --yes tsx scripts/serve-static-export.mjs",
    "test:smoke-api": "node scripts/smoke-api.mjs",
    "test:smoke-transport": "node scripts/smoke-transport.mjs",
    "test:smoke-ops": "node scripts/smoke-ops.mjs",
    "test:smoke-ui": "node scripts/smoke-ui.mjs",
    "check:worker-boundary": "node scripts/check-worker-import-boundary.mjs",
    "check:cron-abort-contract": "node scripts/check-cron-abort-contract.mjs",
    "check:cemetery-dataset": "tsx scripts/generate-cemetery-dataset.ts --check",
    "check:openapi": "tsx scripts/generate-openapi-spec.ts --check",
    "check:postman": "tsx scripts/generate-postman-collection.ts --check",
    "check:world-map": "tsx scripts/build-world-map-svg.ts --check",
    "check:unused-code": "node scripts/check-unused-code.mjs",
    "check:shared-cycles": "node scripts/check-shared-cycles.mjs",
    "check:hotspot-ratchet": "node scripts/check-hotspot-ratchet.mjs",
    "check:harbor-palette": "node scripts/check-harbor-palette.mjs",
    "check:redemption-backstops": "tsx scripts/check-redemption-backstops.ts",
    "check:hotspot-ratchet:update-baseline": "node scripts/update-hotspot-ratchet-baseline.mjs",
    "check:cron-sync": "tsx scripts/check-cron-schedule-sync.ts",
    "check:doc-counts": "node scripts/check-doc-counts.mjs",
    "check:verified-doc-links": "node scripts/check-verified-doc-links.mjs",
    "check:doc-source-paths": "node scripts/check-doc-source-paths.mjs",
    "check:doc-sync": "tsx scripts/check-doc-sync.ts",
    "check:env-contract": "tsx scripts/check-env-contract.mjs",
    "check:duplicate-exports": "node scripts/check-duplicate-exports.mjs",
    "check:migrations": "node scripts/check-worker-migrations.mjs",
    "check:cron-connections": "tsx scripts/check-cron-connection-budget.ts",
    "check:sql-safety": "node scripts/check-sql-interpolation-safety.mjs",
    "check:stablecoin-data": "tsx scripts/check-stablecoin-data.ts",
    "check:llms-txt": "tsx scripts/generate-llms-txt.ts --check",
    "refresh:html-fixtures": "tsx scripts/refresh-reserve-html-fixtures.ts",
    "seo:check": "node scripts/check-seo-static.mjs",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks",
    "test:visual": "playwright test tests/visual"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "d3-force": "^3.0.0",
    "gsap": "3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "10.1.0",
    "react-tweet": "3.3.0",
    "recharts": "^3.8.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "3.1.0",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@vitest/coverage-v8": "^4.1.4",
    "d3-geo": "3.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.0.2",
    "madge": "8.0.0",
    "npm-run-all2": "8.0.4",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.2",
    "topojson-client": "3.1.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.4"
  }
}
