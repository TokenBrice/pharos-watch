{
  "name": "pharos-watch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "worker"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "node scripts/maintenance/dev.mjs",
    "dev:next": "next dev",
    "dev:proxy": "node scripts/maintenance/dev-api-proxy.mjs",
    "prebuild": "node scripts/maintenance/run-generated-artifacts.mjs",
    "build": "next build",
    "build:world-map": "tsx scripts/maintenance/build-world-map-svg.ts",
    "postbuild": "tsx scripts/maintenance/generate-markdown-exports.ts && node scripts/maintenance/inline-homepage-critical-css.mjs",
    "start": "npm run serve:static-export",
    "lint": "npm run check:table-primitives && eslint . --cache --cache-strategy content --cache-location .cache/eslint/ --max-warnings=0",
    "lint:typed": "eslint --config eslint.typed.config.mjs \"worker/src/**/*.ts\" \"worker/src/**/*.tsx\" \"shared/lib/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:worker": "cd worker && npx tsc --noEmit",
    "audit:deps": "npm audit --audit-level=high --omit=dev",
    "test": "vitest run",
    "test:profile": "node scripts/maintenance/profile-vitest.mjs",
    "test:critical-contracts": "node scripts/maintenance/run-critical-contracts.mjs",
    "test:invariants": "vitest run src/lib/__tests__/critical-invariants.test.ts worker/src/lib/__tests__/api-utils.test.ts worker/src/cron/__tests__/sync-stablecoins.test.ts worker/src/cron/__tests__/sync-yield-data.test.ts",
    "test:noncritical": "node scripts/maintenance/run-noncritical-tests.mjs",
    "coverage:critical": "node scripts/maintenance/run-critical-coverage.mjs",
    "coverage:critical:update-baseline": "node scripts/maintenance/update-critical-coverage-baseline.mjs",
    "test:merge-gate": "node scripts/maintenance/test-merge-gate.mjs",
    "validate:pages-smoke": "node scripts/maintenance/run-pages-smoke.mjs",
    "validate:worker-smoke": "node scripts/maintenance/run-worker-smoke.mjs",
    "validate:prebuild": "node scripts/maintenance/run-validate-prebuild.mjs",
    "lighthouse:static": "tsx scripts/maintenance/lighthouse-static-export.mjs",
    "check:generated-artifacts": "node scripts/maintenance/run-generated-artifacts.mjs --check",
    "test:watch": "vitest",
    "audit:pricing-providers": "tsx scripts/maintenance/audit-pricing-provider-config.ts",
    "audit:price-source-depth": "tsx scripts/maintenance/audit-price-source-depth.ts",
    "audit:dia-provider": "tsx scripts/maintenance/audit-dia-provider-poc.ts",
    "ops:d1-insights": "node scripts/maintenance/capture-d1-insights.mjs",
    "calibrate:yield-pys-v8": "tsx scripts/maintenance/yield-pys-v8-calibration.ts",
    "freeze-stablecoin": "tsx scripts/maintenance/freeze-stablecoin.ts",
    "sync:digests": "tsx scripts/maintenance/sync-digests.ts",
    "serve:static-export": "tsx scripts/maintenance/serve-static-export.mjs",
    "test:a11y": "playwright test tests/visual/a11y/axe-routes.spec.ts",
    "test:a11y:hydrated": "playwright test tests/visual/a11y/axe-routes-hydrated.spec.ts",
    "test:smoke-api": "node scripts/maintenance/smoke-api.mjs",
    "test:smoke-transport": "node scripts/maintenance/smoke-transport.mjs",
    "test:smoke-ops": "node scripts/maintenance/smoke-ops.mjs",
    "test:smoke-ui": "node scripts/maintenance/smoke-ui.mjs",
    "test:smoke-ui:mobile": "node scripts/maintenance/smoke-mobile-ui.mjs --strict-touch-targets",
    "check:worker-boundary": "node scripts/ci/check-worker-import-boundary.mjs",
    "check:table-primitives": "node scripts/ci/check-table-primitives.mjs",
    "check:cron-abort-contract": "node scripts/ci/check-cron-abort-contract.mjs",
    "check:cron-console-usage": "node scripts/ci/check-cron-console-usage.mjs",
    "check:cron-console-usage:update-baseline": "node scripts/ci/check-cron-console-usage.mjs --update-baseline",
    "check:cemetery-dataset": "tsx scripts/maintenance/generate-cemetery-dataset.ts --check",
    "check:openapi": "tsx scripts/maintenance/generate-openapi-spec.ts --check",
    "check:postman": "tsx scripts/maintenance/generate-postman-collection.ts --check",
    "check:world-map": "tsx scripts/maintenance/build-world-map-svg.ts --check",
    "check:unused-code": "node scripts/ci/check-unused-code.mjs",
    "check:script-entrypoints": "node scripts/ci/check-script-entrypoints.mjs",
    "check:shared-cycles": "node scripts/ci/check-shared-cycles.mjs",
    "check:shared-types-imports": "node scripts/ci/check-shared-types-imports.mjs",
    "check:client-registry-imports": "node scripts/ci/check-client-registry-imports.mjs",
    "check:supply-helper-usage": "node scripts/ci/check-supply-helper-usage.mjs",
    "check:hook-polling-window": "node scripts/ci/check-hook-polling-window.mjs",
    "check:hotspot-ratchet": "node scripts/ci/check-hotspot-ratchet.mjs",
    "check:site-csp-sync": "tsx scripts/ci/check-site-csp-sync.ts",
    "check:redemption-backstops": "tsx scripts/ci/check-redemption-backstops.ts",
    "check:redemption-coverage-audit": "tsx scripts/maintenance/generate-redemption-coverage-audit.ts --check",
    "check:hotspot-ratchet:update-baseline": "node scripts/maintenance/update-hotspot-ratchet-baseline.mjs",
    "check:cron-sync": "tsx scripts/ci/check-cron-schedule-sync.ts",
    "check:doc-counts": "node scripts/ci/check-doc-counts.mjs",
    "check:agent-doc-sync": "node scripts/ci/check-agent-doc-sync.mjs",
    "check:agent-skill-symlinks": "node scripts/ci/check-agent-skill-symlinks.mjs",
    "check:frozen-invariants": "tsx scripts/ci/check-frozen-invariants.ts",
    "check:verified-doc-links": "node scripts/ci/check-verified-doc-links.mjs",
    "check:doc-source-paths": "node scripts/ci/check-doc-source-paths.mjs",
    "check:doc-sync": "tsx scripts/ci/check-doc-sync.ts",
    "check:env-contract": "tsx scripts/ci/check-env-contract.mjs",
    "check:duplicate-exports": "node scripts/ci/check-duplicate-exports.mjs",
    "check:migrations": "node scripts/ci/check-worker-migrations.mjs",
    "check:cron-connections": "tsx scripts/ci/check-cron-connection-budget.ts",
    "check:price-bounds-parity": "tsx scripts/ci/check-price-bounds-parity.ts",
    "check:telegram-load": "tsx scripts/ci/check-telegram-load.ts --enforce-target-slo",
    "check:sql-safety": "node scripts/ci/check-sql-interpolation-safety.mjs",
    "check:stale-flags": "node scripts/ci/check-stale-flags.mjs",
    "check:stablecoin-data": "tsx scripts/ci/check-stablecoin-data.ts",
    "check:dependency-coverage": "tsx scripts/maintenance/generate-dependency-coverage-audit.ts --check",
    "audit:reserve-coverage": "tsx scripts/maintenance/generate-reserve-coverage-audit.ts",
    "check:attestor-tier-coverage": "tsx scripts/ci/check-attestor-tier-coverage.ts",
    "check:glossary-coverage": "tsx scripts/ci/check-glossary-coverage.ts",
    "check:one-liner-coverage": "tsx scripts/ci/check-one-liner-coverage.ts",
    "check:mechanism-archetype-coverage": "tsx scripts/ci/check-mechanism-archetype-coverage.ts",
    "check:archetype-explainer-coverage": "tsx scripts/ci/check-archetype-explainer-coverage.ts",
    "candidates:annotations": "tsx scripts/maintenance/build-annotation-candidates.ts",
    "candidates:ai-summaries": "tsx scripts/maintenance/build-ai-summary-staleness-candidates.ts",
    "backfill:ai-summary-provenance": "node scripts/maintenance/backfill-ai-summary-provenance.mjs",
    "generate:pwa-icons": "node scripts/maintenance/generate-pwa-icons.mjs",
    "subset:fonts": "node scripts/maintenance/subset-fonts.mjs",
    "generate:public-datasets": "tsx scripts/maintenance/generate-public-datasets.ts",
    "digest:curation": "node scripts/maintenance/weekly-curation-digest.mjs",
    "check:build-size": "node scripts/maintenance/report-build-size.mjs --check",
    "check:build-attribution": "node scripts/ci/check-build-attribution.mjs",
    "check:build-attribution:update-baseline": "node scripts/maintenance/update-build-attribution-baseline.mjs",
    "check:phishing-signatures": "node scripts/ci/check-phishing-signatures.mjs",
    "check:classifier-sensitive-copy": "node scripts/ci/check-classifier-sensitive-copy.mjs",
    "check:safe-browsing": "node scripts/ci/check-safe-browsing.mjs",
    "check:llms-txt": "tsx scripts/maintenance/generate-llms-txt.ts --check",
    "check:reserve-fixture-freshness": "node scripts/ci/check-reserve-fixture-freshness.mjs",
    "check:selector-banned-phrases": "node scripts/ci/check-selector-banned-phrases.mjs",
    "check:feature-flag-inlining": "node scripts/ci/check-feature-flag-inlining.mjs",
    "check:docs-api-reference": "node scripts/maintenance/generate-api-reference.mjs --check",
    "refresh:html-fixtures": "tsx scripts/maintenance/refresh-reserve-html-fixtures.ts",
    "seo:live-smoke": "node scripts/ci/check-seo-live-smoke.mjs",
    "seo:check": "node scripts/ci/check-seo-static.mjs",
    "analyze:gsc-coverage": "node scripts/maintenance/analyze-gsc-coverage.mjs",
    "analyze:gsc-performance": "node scripts/maintenance/analyze-gsc-performance.mjs",
    "og:capture": "node scripts/maintenance/screenshot-og.mjs",
    "check:og-learn": "node scripts/maintenance/build-og-learn-images.mjs --check",
    "build:og-editorial": "node scripts/maintenance/build-og-editorial.mjs",
    "check:og-editorial": "node scripts/maintenance/build-og-editorial.mjs --check",
    "build:og-case-studies": "node scripts/maintenance/build-og-case-studies.mjs",
    "check:og-case-studies": "node scripts/maintenance/build-og-case-studies.mjs --check",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-virtual": "^3.13.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "10.1.0",
    "react-tweet": "^3.3.0",
    "recharts": "^3.8.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "3.1.0",
    "@types/node": "24.12.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@vitest/coverage-v8": "^4.1.7",
    "beasties": "0.4.2",
    "d3-geo": "3.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.1.1",
    "madge": "8.0.0",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "topojson-client": "3.1.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.7"
  }
}
