{
  "name": "stablecoin-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "worker"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-redirects.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:deps": "npm audit --audit-level=high --omit=dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:critical-contracts": "vitest run src/lib/__tests__/api-fetch-contracts.test.ts src/lib/__tests__/api-endpoints.test.ts worker/src/api/__tests__/router-contract.test.ts worker/src/api/__tests__/cache-passthrough.test.ts worker/src/api/__tests__/peg-summary.test.ts worker/src/api/__tests__/report-cards.test.ts worker/src/api/__tests__/stability-index.test.ts worker/src/api/__tests__/dex-liquidity.test.ts worker/src/api/__tests__/stress-signals.test.ts worker/src/api/__tests__/mint-burn-flows.test.ts",
    "test:invariants": "vitest run src/lib/__tests__/critical-invariants.test.ts worker/src/lib/__tests__/api-utils.test.ts worker/src/cron/__tests__/sync-stablecoins.test.ts worker/src/cron/__tests__/sync-yield-data.test.ts",
    "coverage:critical": "vitest run --coverage --coverage.thresholds.lines=0 src/lib/__tests__/api-fetch-contracts.test.ts src/lib/__tests__/critical-invariants.test.ts worker/src/__tests__/index.scheduled.test.ts worker/src/lib/__tests__/api-utils.test.ts worker/src/lib/__tests__/alerts.test.ts worker/src/lib/__tests__/auth.test.ts worker/src/lib/__tests__/evm-rpc.test.ts worker/src/lib/__tests__/safety-scores.test.ts worker/src/lib/__tests__/stablecoins-cache.test.ts worker/src/api/__tests__/cache-passthrough.test.ts worker/src/api/__tests__/discovery.test.ts worker/src/api/__tests__/health.test.ts worker/src/api/__tests__/peg-summary.test.ts worker/src/api/__tests__/report-cards.test.ts worker/src/api/__tests__/dex-liquidity.test.ts worker/src/api/__tests__/stress-signals.test.ts worker/src/api/__tests__/mint-burn-flows.test.ts worker/src/api/__tests__/stablecoin-detail.test.ts worker/src/api/__tests__/status.test.ts worker/src/cron/__tests__/daily-digest.test.ts worker/src/cron/__tests__/sync-stablecoins.test.ts worker/src/cron/__tests__/sync-yield-data.test.ts worker/src/cron/__tests__/sync-dex-liquidity.test.ts && node scripts/check-critical-coverage.mjs",
    "coverage:critical:update-baseline": "node scripts/update-critical-coverage-baseline.mjs",
    "test:merge-gate": "node scripts/test-merge-gate.mjs",
    "test:watch": "vitest",
    "sync:digests": "tsx scripts/sync-digests.ts",
    "test:smoke-api": "tsx scripts/smoke-api.mjs",
    "test:smoke-ops": "node scripts/smoke-ops.mjs",
    "test:smoke-ui": "node scripts/smoke-ui.mjs",
    "check:worker-boundary": "node scripts/check-worker-import-boundary.mjs",
    "check:cron-sync": "tsx scripts/check-cron-schedule-sync.ts",
    "check:migrations": "node scripts/check-worker-migrations.mjs",
    "seo:check": "node scripts/check-seo-static.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  }
}
