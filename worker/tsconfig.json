{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2021"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "@shared/data/*": ["../shared/data/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "src/scripts"]
}
