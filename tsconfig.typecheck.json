{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "functions/**/*.ts",
    "functions/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "worker",
    "worktrees",
    ".next",
    "coverage",
    "out",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
