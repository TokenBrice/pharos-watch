{
  "schemaVersion": 1,
  "reviewedAt": "2026-10-30",
  "policy": {
    "laneIdentity": "bridge-route-deployment",
    "subjectRule": "subjectDeploymentKey is the reviewed bridge route id (`bridgeRouteRisk.routes[].id`, `chain:contractAddress`), never a controller: IR-1c closure compares certificate.subjectDeploymentKey with the compiled bridge control's deploymentKey.",
    "emitterRule": "Emitters are the contracts that emit the lane's admin events: the route deployment itself, and per contributor the governed contract whose ownership/role/config events encode that contributor's power. Holder Safes and EOAs are never emitters; their power appears as the governed contract's OwnershipTransferred/RoleGranted/RoleRevoked events. Every contributor maps to at least one lane emitter, recorded in the inventory.",
    "abiCompletenessRule": "Each emitter records the admin-relevant events of its verified ABI (ownership, roles, pause, upgrade, peer/remote-pool/chain config, router/rate limits, and fund-moving rescue/freeze administration). A lane is admissible only when every recorded admin event is a frozen V9 lane admin-event family; otherwise the lane is `no-reviewed-emitter` with `abi-not-covered` and the uncovered names, so a clean certificate can never assert absence for an unscreened admin surface (R1/R2).",
    "pinConvention": "sha256-decoded-runtime-bytes:<64 lowercase hex>, sha256 of the decoded runtime code read with eth_getCode at the recorded pinned block. Proxy addresses are the emitters because logs are emitted at the proxy; the ABI is the implementation ABI.",
    "minimumLookbackBlocks": 50000,
    "lookbackRule": "Per chain, at least 50,000 blocks (IR-3a's explorer-events floor) and never more than the 32-page x 10,000-block certificate budget.",
    "abiBasisRule": "A non-Ethereum emitter reuses a recorded ABI only with an explicit basis: `same-runtime-code` when the reviewed proxy and implementation runtime code hashes are identical to the Ethereum basis, `same-verified-type` when the deployment has the same verified contract type and byte length but chain-specific immutables, and `verified-source` when the emitter itself was verified on its own chain.",
    "sources": [
      "https://etherscan.io/address/0xf077771c2a09ab77678e3945b07db8586d205340#code",
      "https://eth.blockscout.com/address/0x6be164af10879a86e4643089638b6864ef12b1ee?tab=contract",
      "https://eth.blockscout.com/address/0x5bf44d32260aee6b807c490e92ef0481d15ab493?tab=contract",
      "https://eth.blockscout.com/address/0x19056eb5ea89f22202ae1c9cefe685193a894d64?tab=contract",
      "https://docs.chain.link/ccip"
    ]
  },
