{
  "zone": {
    "name": "pharos.watch",
    "status": "active"
  },
  "pages": {
    "project": {
      "name": "stablecoin-dashboard",
      "production": {
        "environmentVariables": {
          "CF_ACCESS_OPS_UI_AUD": {
            "type": "plain_text"
          },
          "CF_ACCESS_TEAM_DOMAIN": {
            "type": "secret_text"
          },
          "OPS_API_SERVICE_TOKEN_ID": {
            "type": "secret_text"
          },
          "OPS_API_SERVICE_TOKEN_SECRET": {
            "type": "secret_text"
          },
          "SELECTOR_SNAPSHOT_IP_HASH_SECRET": {
            "type": "secret_text"
          },
          "SITE_API_ORIGIN": {
            "type": "plain_text",
            "value": "https://site-api.pharos.watch"
          },
          "SITE_API_SHARED_SECRET": {
            "type": "secret_text"
          },
          "TELEGRAM_ADOPTION_IP_HASH_SECRET": {
            "type": "secret_text"
          }
        },
        "d1Bindings": [
          "DB"
        ],
        "kvBindings": [
          "SELECTOR_SNAPSHOTS"
        ]
      }
    },
    "customDomains": [
      "ops.pharos.watch",
      "pharos.watch"
    ]
  },
  "accessApplications": [
    {
      "type": "self_hosted",
      "selfHostedDomains": [
        "ops.pharos.watch/*"
      ],
      "sessionDuration": "12h"
    },
    {
      "type": "self_hosted",
      "selfHostedDomains": [
        "ops-api.pharos.watch/*"
      ],
      "sessionDuration": ""
    }
  ],
  "workerDomains": [
    {
      "hostname": "api.pharos.watch",
      "service": "stablecoin-api"
    },
    {
      "hostname": "ops-api.pharos.watch",
      "service": "stablecoin-api"
    },
    {
      "hostname": "site-api.pharos.watch",
      "service": "stablecoin-api"
    }
  ],
  "rateLimitRules": [
    {
      "description": "api-rate-limit-ip",
      "enabled": true,
      "action": "block",
      "expression": "(http.host eq \"api.pharos.watch\" and starts_with(http.request.uri.path, \"/api/\") and not cf.bot_management.verified_bot)",
      "ratelimit": {
        "characteristics": [
          "cf.colo.id",
          "ip.src"
        ],
        "requestsPerPeriod": 120,
        "period": 10,
        "mitigationTimeout": 10
      }
    }
  ]
}
