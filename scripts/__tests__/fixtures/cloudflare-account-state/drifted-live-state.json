{
  "zone": {
    "name": "pharos.watch",
    "status": "active"
  },
  "pages": {
    "project": {
      "name": "stablecoin-dashboard",
      "production": {
        "environmentVariables": {
          "CF_ACCESS_OPS_UI_AUD": { "type": "plain_text" },
          "CF_ACCESS_TEAM_DOMAIN": { "type": "plain_text" },
          "OPS_API_SERVICE_TOKEN_ID": { "type": "secret_text" },
          "OPS_API_SERVICE_TOKEN_SECRET": { "type": "secret_text" },
          "SELECTOR_SNAPSHOT_IP_HASH_SECRET": { "type": "secret_text" },
          "SITE_API_ORIGIN": { "type": "plain_text", "value": "https://wrong.example" },
          "SITE_API_SHARED_SECRET": { "type": "secret_text" },
          "TELEGRAM_ADOPTION_IP_HASH_SECRET": { "type": "plain_text" }
        },
        "d1Bindings": ["DB"],
        "kvBindings": []
      }
    },
    "customDomains": ["pharos.watch"]
  },
  "accessApplications": [
    {
      "type": "self_hosted",
      "selfHostedDomains": ["ops.pharos.watch/*"],
      "sessionDuration": "24h"
    },
    {
      "type": "self_hosted",
      "selfHostedDomains": ["ops-api.pharos.watch/*"],
      "sessionDuration": ""
    }
  ],
  "workerDomains": [
    { "hostname": "api.pharos.watch", "service": "stablecoin-api" },
    { "hostname": "ops-api.pharos.watch", "service": "other-service" },
    { "hostname": "site-api.pharos.watch", "service": "stablecoin-api" }
  ],
  "rateLimitRules": [
    {
      "description": "api-rate-limit-ip",
      "enabled": true,
      "action": "managed_challenge",
      "expression": "(http.host eq \"api.pharos.watch\" and starts_with(http.request.uri.path, \"/api/\") and not (http.request.uri.path in {\"/api/telegram-webhook\" \"/api/telegram-mini-app/session\" \"/api/telegram-mini-app/mutate\"}) and not cf.bot_management.verified_bot)",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "requestsPerPeriod": 120,
        "period": 10,
        "mitigationTimeout": 10
      }
    },
    {
      "description": "api-self-serve-key-intake-limit",
      "enabled": true,
      "action": "block",
      "expression": "(http.host eq \"api.pharos.watch\" and http.request.method eq \"POST\" and (http.request.uri.path eq \"/api/api-key-requests\" or http.request.uri.path eq \"/api/api-key-requests/verify\") and not cf.bot_management.verified_bot)",
      "ratelimit": {
        "characteristics": ["ip.src"],
        "requestsPerPeriod": 20,
        "period": 60,
        "mitigationTimeout": 600
      }
    },
    {
      "description": "telegram-webhook-ingress-limit",
      "enabled": true,
      "action": "block",
      "expression": "(http.host eq \"api.pharos.watch\" and http.request.method eq \"POST\" and http.request.uri.path eq \"/api/telegram-webhook\")",
      "ratelimit": {
        "characteristics": ["ip.src", "cf.colo.id"],
        "requestsPerPeriod": 2400,
        "period": 60,
        "mitigationTimeout": 60
      }
    },
    {
      "description": "telegram-mini-app-session-ingress-limit",
      "enabled": true,
      "action": "block",
      "expression": "(http.host eq \"api.pharos.watch\" and http.request.method eq \"POST\" and http.request.uri.path eq \"/api/telegram-mini-app/session\")",
      "ratelimit": {
        "characteristics": ["ip.src", "cf.colo.id"],
        "requestsPerPeriod": 120,
        "period": 60,
        "mitigationTimeout": 60
      }
    },
    {
      "description": "telegram-mini-app-mutation-ingress-limit",
      "enabled": true,
      "action": "block",
      "expression": "(http.host eq \"api.pharos.watch\" and http.request.method eq \"POST\" and http.request.uri.path eq \"/api/telegram-mini-app/mutate\")",
      "ratelimit": {
        "characteristics": ["ip.src", "cf.colo.id"],
        "requestsPerPeriod": 360,
        "period": 60,
        "mitigationTimeout": 60
      }
    }
  ]
}
