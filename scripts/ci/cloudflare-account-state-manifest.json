{
 "version": 1,
 "zone": {
  "name": "pharos.watch",
  "status": "active"
 },
 "pages": {
  "project": "stablecoin-dashboard",
  "production": {
   "requiredEnvironmentVariables": [
    {
     "name": "CF_ACCESS_OPS_UI_AUD",
     "type": "plain_text"
    },
    {
     "name": "CF_ACCESS_TEAM_DOMAIN",
     "type": "secret_text"
    },
    {
     "name": "OPS_API_SERVICE_TOKEN_ID",
     "type": "secret_text"
    },
    {
     "name": "OPS_API_SERVICE_TOKEN_SECRET",
     "type": "secret_text"
    },
    {
     "name": "SELECTOR_SNAPSHOT_IP_HASH_SECRET",
     "type": "secret_text"
    },
    {
     "name": "SITE_API_ORIGIN",
     "type": "plain_text",
     "value": "https://site-api.pharos.watch"
    },
    {
     "name": "SITE_API_SHARED_SECRET",
     "type": "secret_text"
    },
    {
     "name": "TELEGRAM_ADOPTION_IP_HASH_SECRET",
     "type": "secret_text"
    }
   ],
   "requiredD1Bindings": [
    "DB"
   ],
   "requiredKvBindings": [
    "SELECTOR_SNAPSHOTS"
   ]
  },
  "customDomains": [
   "ops.pharos.watch",
   "pharos.watch"
  ]
 },
 "accessApplications": [
  {
   "key": "operator-ui",
   "type": "self_hosted",
   "selfHostedDomains": [
    "ops.pharos.watch/*"
   ],
   "sessionDuration": "12h"
  },
  {
   "key": "operator-api",
   "type": "self_hosted",
   "selfHostedDomains": [
    "ops-api.pharos.watch/*"
   ]
  }
 ],
 "workerCustomDomains": {
  "service": "stablecoin-api",
  "hostnames": [
   "api.pharos.watch",
   "ops-api.pharos.watch",
   "site-api.pharos.watch"
  ]
 },
 "rateLimitRules": [
  {
   "description": "api-rate-limit-ip",
   "enabled": false,
   "action": "block",
   "expression": "(http.host eq \"api.pharos.watch\" and starts_with(http.request.uri.path, \"/api/\") and not cf.bot_management.verified_bot)",
   "ratelimit": {
    "characteristics": [
     "cf.colo.id",
     "ip.src"
    ],
    "requestsPerPeriod": 120,
    "period": 10,
    "mitigationTimeout": 10
   }
  }
 ],
 "rateLimitOrdering": []
}
