// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mechanismDiagramFor > renders the algorithmic diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 155" class="hidden sm:block w-full text-foreground" role="img" aria-label="An algorithmic mint/burn module trades a governance token for USDC to defend the peg; the design has no 1:1 reserve backing."><desc>Users burn a governance token to algorithmically mint USDC; an autonomous mint/burn module defends the peg through arbitrage incentives; the system has no 1:1 reserve backing, so confidence in the governance token is critical.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="color-mix(in oklch, var(--severity-severe) 8%, var(--card))" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="5 3"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Burn governance token</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">algorithmic mint</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="4 3"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="color-mix(in oklch, var(--severity-severe) 8%, var(--card))" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="5 3"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Mint/burn AMO</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">defends peg via arbitrage</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="4 3"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="color-mix(in oklch, var(--severity-severe) 8%, var(--card))" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="5 3"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">no 1:1 backing</text></g><g><path d="M 500 90 C 500 140 75 140 75 101" fill="none" stroke="var(--severity-severe)" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="4 3"></path><polygon points="69.5,101 80.5,101 75,90" fill="var(--severity-severe)"></polygon><text x="287.5" y="108" text-anchor="middle" font-size="10" font-weight="600" fill="var(--severity-severe)">reflexive collapse</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: reflexive collapse (UST, May 2022)</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="An algorithmic mint/burn module trades a governance token for USDC to defend the peg; the design has no 1:1 reserve backing."><desc>Users burn a governance token to algorithmically mint USDC; an autonomous mint/burn module defends the peg through arbitrage incentives; the system has no 1:1 reserve backing, so confidence in the governance token is critical.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="3 3"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-algorithmic)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Burn governance token</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">algorithmic mint</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="3 3"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-algorithmic)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Mint/burn AMO</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">defends peg via arbitrage</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1" stroke-dasharray="3 3"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-algorithmic)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-algorithmic)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">no 1:1 backing</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;

exports[`mechanismDiagramFor > renders the cdp diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 155" class="hidden sm:block w-full text-foreground" role="img" aria-label="Users overcollateralize crypto in a vault to mint USDC as debt; the position is liquidated if collateral falls below the safety ratio."><desc>Users deposit crypto collateral worth more than the debt they want to issue; a vault or peg-stability module mints USDC as debt against the collateral; the position is liquidated if the collateral value falls below the configured safety ratio.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Crypto collateral</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">overcollateralized</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Vault / PSM</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">mint debt vs collateral</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">liquidates below ratio</text></g><g><path d="M 500 90 C 500 140 75 140 75 101" fill="none" stroke="var(--severity-severe)" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="4 3"></path><polygon points="69.5,101 80.5,101 75,90" fill="var(--severity-severe)"></polygon><text x="287.5" y="108" text-anchor="middle" font-size="10" font-weight="600" fill="var(--severity-severe)">or liquidated</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: collateral cascade (DAI, Mar 2020)</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="Users overcollateralize crypto in a vault to mint USDC as debt; the position is liquidated if collateral falls below the safety ratio."><desc>Users deposit crypto collateral worth more than the debt they want to issue; a vault or peg-stability module mints USDC as debt against the collateral; the position is liquidated if the collateral value falls below the configured safety ratio.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-cdp)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Crypto collateral</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">overcollateralized</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-cdp)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Vault / PSM</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">mint debt vs collateral</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-cdp)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-cdp)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">liquidates below ratio</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;

exports[`mechanismDiagramFor > renders the fiat-cash diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 155" class="hidden sm:block w-full text-foreground" role="img" aria-label="USDC mechanism: user dollars in, custodied 1:1, redeemable on demand"><desc>Users send USD via wire or ACH to the issuer; the issuer custodies the dollars in cash, repos, and short-term Treasuries; the issuer mints USDC 1:1 and lets holders redeem at any time.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">User USD</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">wire / ACH</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Issuer reserves</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">custodied 1:1</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">redeem any time</text></g><g><path d="M 500 90 C 500 140 275 140 275 101" fill="none" stroke="var(--text-tertiary)" stroke-width="1.2" stroke-linecap="round"></path><polygon points="269.5,101 280.5,101 275,90" fill="var(--text-tertiary)"></polygon><text x="387.5" y="108" text-anchor="middle" font-size="10" font-weight="600" fill="var(--text-secondary)">redeem</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: banking-rail freeze (USDC, Mar 2023)</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="USDC mechanism: user dollars in, custodied 1:1, redeemable on demand"><desc>Users send USD via wire or ACH to the issuer; the issuer custodies the dollars in cash, repos, and short-term Treasuries; the issuer mints USDC 1:1 and lets holders redeem at any time.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-fiat-cash)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">User USD</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">wire / ACH</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-fiat-cash)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Issuer reserves</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">custodied 1:1</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-fiat-cash)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-fiat-cash)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">redeem any time</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;

exports[`mechanismDiagramFor > renders the rwa-credit-fund diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 155" class="hidden sm:block w-full text-foreground" role="img" aria-label="Accredited investor cash funds a private-credit or CLO portfolio; ACRED fund-share NAV reflects credit losses with quarterly redemption gates."><desc>Accredited investors subscribe cash into a regulated credit fund; the fund deploys into private credit, CLOs, or structured debt with real default risk and limited liquidity; ACRED represents a fund share whose NAV reflects credit performance, with redemptions typically allowed only at quarterly windows.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Investor cash</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">subscribed via fund (KYC)</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Private credit / CLO</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">credit risk, illiquid</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">ACRED fund-share</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">NAV reflects credit losses</text></g><g><path d="M 500 90 C 500 140 75 140 75 101" fill="none" stroke="var(--text-tertiary)" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="4 3"></path><polygon points="69.5,101 80.5,101 75,90" fill="var(--text-tertiary)"></polygon><text x="287.5" y="108" text-anchor="middle" font-size="10" font-weight="600" fill="var(--text-secondary)">quarterly redemption</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: NAV markdown / quarterly gate</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="Accredited investor cash funds a private-credit or CLO portfolio; ACRED fund-share NAV reflects credit losses with quarterly redemption gates."><desc>Accredited investors subscribe cash into a regulated credit fund; the fund deploys into private credit, CLOs, or structured debt with real default risk and limited liquidity; ACRED represents a fund share whose NAV reflects credit performance, with redemptions typically allowed only at quarterly windows.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-rwa-credit-fund)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Investor cash</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">subscribed via fund (KYC)</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-rwa-credit-fund)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Private credit / CLO</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">credit risk, illiquid</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-rwa-credit-fund)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-rwa-credit-fund)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">ACRED fund-share</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">NAV reflects credit losses</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;

exports[`mechanismDiagramFor > renders the synthetic-delta-neutral diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 120" class="hidden sm:block w-full text-foreground" role="img" aria-label="Crypto deposited as spot collateral is hedged with equal short perp positions; the funding rate paid by perp longs becomes the yield on USDC."><desc>Users deposit crypto as spot collateral; the protocol opens an equal-size short perpetual futures position to neutralize price exposure; the funding rate paid by perp longs flows to USDC holders as yield.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Crypto deposit</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">spot collateral</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><polygon points="34,20 42,20 38,13" fill="var(--severity-healthy)"></polygon><text x="48" y="24" font-size="11" font-weight="600" fill="currentColor">Long spot</text><polygon points="34,42 42,42 38,49" fill="var(--severity-severe)"></polygon><text x="48" y="47" font-size="11" font-weight="600" fill="currentColor">Short perp</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">funding-rate yield</text></g><g><path d="M 275 30 Q 387.5 6 489 30" fill="none" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></path><polygon points="489,24.5 500,30 489,35.5" fill="var(--text-tertiary)"></polygon><text x="387.5" y="9" text-anchor="middle" font-size="9" font-style="italic" fill="var(--text-tertiary)">funding</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: funding-rate inversion</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="Crypto deposited as spot collateral is hedged with equal short perp positions; the funding rate paid by perp longs becomes the yield on USDC."><desc>Users deposit crypto as spot collateral; the protocol opens an equal-size short perpetual futures position to neutralize price exposure; the funding rate paid by perp longs flows to USDC holders as yield.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-synthetic-delta-neutral)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Crypto deposit</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">spot collateral</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-synthetic-delta-neutral)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Long spot + short perp</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">delta-neutral hedge</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-synthetic-delta-neutral)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-synthetic-delta-neutral)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC minted</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">funding-rate yield</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;

exports[`mechanismDiagramFor > renders the tbill diagram 1`] = `"<div class="w-full max-w-2xl"><svg viewBox="0 0 600 120" class="hidden sm:block w-full text-foreground" role="img" aria-label="Investor cash funds a short-duration Treasury portfolio; USDC units accrue NAV daily."><desc>Investors subscribe cash into a regulated fund; the fund deploys into short-duration T-Bills and repurchase agreements; USDC units represent fund shares whose NAV accrues daily from the underlying yield.</desc><g transform="translate(0, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Investor cash</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">subscribed via fund</text></g><g transform="translate(150, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(200, 30)"><rect x="0" y="0" width="150" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="75" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">T-Bills + Repos</text><text x="75" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">short-duration RWA</text></g><g transform="translate(350, 60)"><line x1="0" y1="0" x2="39" y2="0" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="39,-5.5 50,0 39,5.5" fill="var(--text-tertiary)"></polygon></g><g transform="translate(400, 30)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><text x="9" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC units</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">NAV accrues daily</text></g></svg><p class="hidden sm:block mx-auto mt-2 max-w-2xl text-center text-xs italic" style="color: var(--text-tertiary);">stress: instant-redemption cap / USDC rail constraint (OUSG)</p><svg viewBox="0 0 220 288" class="block sm:hidden mx-auto w-full max-w-[260px] text-foreground" role="img" aria-label="Investor cash funds a short-duration Treasury portfolio; USDC units accrue NAV daily."><desc>Investors subscribe cash into a regulated fund; the fund deploys into short-duration T-Bills and repurchase agreements; USDC units represent fund shares whose NAV accrues daily from the underlying yield.</desc><g transform="translate(10, 10)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-tbill)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">01</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">Investor cash</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">subscribed via fund</text></g><g transform="translate(10, 114)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-tbill)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">02</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">T-Bills + Repos</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">short-duration RWA</text></g><g transform="translate(10, 218)"><rect x="0" y="0" width="200" height="60" rx="6" fill="var(--card)" stroke="var(--border-default)" stroke-width="1"></rect><rect x="0" y="0" width="3" height="60" rx="1.5" fill="var(--mechanism-tbill)"></rect><text x="10" y="13" font-size="8" font-weight="700" letter-spacing="0.12em" fill="var(--mechanism-tbill)" style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">03</text><text x="100" y="28" text-anchor="middle" font-size="13" font-weight="600" fill="currentColor">USDC units</text><text x="100" y="46" text-anchor="middle" font-size="10" fill="var(--text-secondary)">NAV accrues daily</text></g><g transform="translate(110, 78)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g><g transform="translate(110, 182)"><line x1="0" y1="0" x2="0" y2="17" stroke="var(--text-tertiary)" stroke-width="1.75" stroke-linecap="round"></line><polygon points="-5.5,17 5.5,17 0,28" fill="var(--text-tertiary)"></polygon></g></svg></div>"`;
