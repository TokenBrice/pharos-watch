# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/worker/.next/
/out/

# generated build artifacts (keep .d.ts declarations for typecheck)
/src/generated/*
!/src/generated/*.d.ts

# production
/build

# misc
.DS_Store
*.pem
.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env*
!.env.example

# wrangler (generated by `wrangler pages download config`)
/wrangler.toml

# vercel
.vercel

# worktrees
.worktrees/
worktrees

# claude code
.claude/settings.local.json
.playwright-cli/
.mcp.json

# shell/editor config
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.idea
.vscode

# sandbox artifacts
/HEAD
/config
/hooks
/objects
/refs

# internal planning docs
improvement.plan.md

# agent artifacts: keep markdown/docs, ignore runtime spillover
agents/agents/
agents/cron-live-20*/
agents/**/events.jsonl
agents/**/cron-runs*.jsonl
agents/**/wrangler-tail*.jsonl
agents/**/last-rowid
agents/**/monitor.log
agents/**/monitor.mjs
agents/**/*.pid
agents/**/state.json
/.superpowers

# worker
/worker/node_modules
/worker/.wrangler
/worker/.dev.vars
/.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/agents

.claude/commands

# .claude/settings.json is tracked (pre-push hook enforcement)

# cmcs
.cmcs/

# one-time migration artifacts
migration-*.sql
d1-backup-*.sql
worker/d1-backup-*.sql

output/playwright/

# playwright
.playwright-mcp
.playwright-cli
/test-results/
/playwright-report/

.codex

# local screenshot artifacts from browser automation
/alt-pegs-*.png
/*-screenshot.png
.superpowers/
